# =========================================================
# History
# =========================================================

HISTFILE="$XDG_STATE_HOME/zsh/history"
HISTSIZE=100000
SAVEHIST=100000

setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_FIND_NO_DUPS

# =========================================================
# Shell behaviour
# =========================================================

setopt AUTOCD
setopt NOBEEP
setopt NUMERIC_GLOB_SORT  # sort file10 after file9, not after file1

# =========================================================
# Completion
# =========================================================

autoload -Uz compinit
compinit -d "$XDG_CACHE_HOME/zsh/zcompdump"

# Enable interactive completion menu selection
zstyle ':completion:*' menu select

# Make completion case-insensitive
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# =========================================================
# bat
# =========================================================

# bat compiles custom themes (~/.config/bat/themes/*.tmTheme) into a cache
# dir; build it if missing, e.g. on a fresh machine.
if [[ ! -f "${XDG_CACHE_HOME:-$HOME/.cache}/bat/themes.bin" ]]; then
  bat cache --build >/dev/null 2>&1
fi

# =========================================================
# Modular Config Files
# =========================================================

# fzf configuration (must load before bindings.zsh, which binds
# Ctrl+F to a widget it defines)
source "$ZDOTDIR/fzf.zsh"

# Aliases (compdef eza=ls needs compinit, run above)
source "$ZDOTDIR/aliases.zsh"

# Custom keybindings (defines zvm_after_init, which plugins.zsh's
# zsh-vi-mode plugin calls once it finishes loading)
source "$ZDOTDIR/bindings.zsh"

# Plugins and plugin manager
source "$ZDOTDIR/plugins.zsh"

# Prompt/theme
source "$ZDOTDIR/prompt.zsh"

# =========================================================
# Misc integrations
# =========================================================

# sync kitty colors with the persisted base16 theme
eval "kitty @ set-colors -c $HOME/base16-kitty/colors/$(cat "$XDG_CONFIG_HOME/.base16_theme" 2>/dev/null || echo south).conf" 2>/dev/null

# bun completions
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

eval "$(zoxide init zsh)"

# Clear $? so a stray non-zero exit from any command above (e.g. kitty
# color sync running before kitty's remote-control socket is ready) can't
# leak into starship's first status check and show a false error state.
true
